# ============================================================================
# WardAlert — environment template
# Copy to .env and adjust.  Every value below is read by config.py at import
# time; nothing in the codebase hardcodes these.
#   cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------- database --
POSTGRES_USER=wardalert
POSTGRES_PASSWORD=wardalert
POSTGRES_DB=wardalert
POSTGRES_HOST=localhost
# Host port for the compose db. Change if 5432 is already taken on your machine
# (a system Postgres or another container) — everything reads this value.
POSTGRES_PORT=5432
# Seconds main.py waits for pg_isready before giving up
DB_CONNECT_TIMEOUT=60

# ----------------------------------------------------------------- data ----
# Root of the committed public-data folder (relative paths resolve from repo root)
DATA_DIR=data
WARD_BOUNDARY_FILE=data/processed/ward_gsouth_boundary.geojson
DRAINAGE_FILE=data/processed/drainage_gsouth.geojson
FLOOD_SPOTS_FILE=data/processed/flood_spots_gsouth.csv
RAINFALL_FILE=data/processed/rainfall_daily_gsouth.csv
FLOOD_EVENTS_FILE=data/processed/flood_events_gsouth.csv
DEM_FILE=data/raw/N19E072.hgt
WARD_NAME=G/South

# ------------------------------------------------------------ geospatial ---
# EPSG:4326 for storage, EPSG:32643 (UTM 43N) for metric distance maths
SRID=4326
METRIC_SRID=32643
# Radius (m) searched around a spot in the DEM to estimate depression depth
DEPRESSION_RADIUS_M=150

# ------------------------------------------------------- label matching ----
# difflib.SequenceMatcher ratio below which an event is reported unmatched
FUZZY_MATCH_THRESHOLD=0.7

# --------------------------------------------------- feature engineering ---
# Monsoon window used for negative sampling and monsoon_week indexing
MONSOON_START_MONTH=6
MONSOON_END_MONTH=9
# Negatives drawn per positive sample
NEG_POS_RATIO=5
# Auto-raised to this if the built dataset is smaller than MIN_DATASET_ROWS
FALLBACK_NEG_POS_RATIO=10
MIN_DATASET_ROWS=100
# Days of exponentially-decayed rainfall feeding antecedent_moisture
ANTECEDENT_DAYS=3
ANTECEDENT_DECAY=0.5
# Shape of the intra-day rainfall disaggregation curve (higher = peakier)
RAIN_PEAK_HOUR=16
RAIN_DECAY_SIGMA_H=4.0
# A negative sample must sit at least this many hours from any real event
NEGATIVE_EXCLUSION_HOURS=48
RANDOM_SEED=42

# ----------------------------------------------------------- crowd input ---
CROWD_RADIUS_M=500
CROWD_WINDOW_HOURS=2
CROWD_DECAY_HOURS=2.0

# ------------------------------------------------------------- modelling ---
TEST_SIZE=0.25
XGB_N_ESTIMATORS=200
XGB_MAX_DEPTH=3
XGB_LEARNING_RATE=0.08
XGB_SUBSAMPLE=0.9
XGB_COLSAMPLE_BYTREE=0.9
XGB_MIN_CHILD_WEIGHT=1
XGB_REG_LAMBDA=1.0
# Training aborts below this — see ml/train_model_a.py
MIN_MODEL_A_AUC=0.60
MODEL_DIR=ml/models

# -------------------------------------------------------- thresholds -------
# Distance (m) within which a flood event counts as "drain-related" for
# the Youden's J dispatch-threshold fit. Leave at 0 to derive the cutoff from
# the observed nearest_drain_m distribution (see DRAIN_PROXIMITY_PERCENTILE)
# rather than hand-picking a number.
DRAIN_PROXIMITY_M=0
DRAIN_PROXIMITY_PERCENTILE=50
CRITICAL_DELTA_PERCENTILE=90
# Beta-posterior prior and CI width for confidence.py
CONFIDENCE_PRIOR_ALPHA=1.0
CONFIDENCE_PRIOR_BETA=1.0
CONFIDENCE_LEVEL=0.90
# Pseudo-observations backing the Beta posterior (model's effective sample size)
CONFIDENCE_STRENGTH=30

# ----------------------------------------------------------- drain health --
DRAIN_HEALTH_MIN_WEEKS=4
# Monsoon years bootstrapped into the predictions table by drain_health.main
BOOTSTRAP_YEARS=2023,2024,2025
BOOTSTRAP_HOUR=16
# Samples drawn inside each bootstrap week; 1 would make the weekly avg/max
# aggregates meaningless since each week would hold a single prediction.
BOOTSTRAP_SAMPLES_PER_WEEK=3

# ------------------------------------------------------------------- api ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000
API_TITLE=WardAlert API
API_VERSION=0.1.0

# -------------------------------------------------------------- alerts -----
TEMPLATE_DIR=whatsapp_templates
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,hinglish,mr
# Leave TWILIO_ACCOUNT_SID empty to run in simulated mode (logged to alerts_sent)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
ALERT_DEFAULT_RECIPIENT=whatsapp:+910000000000
